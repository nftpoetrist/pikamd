# Copy to .env.local and fill in. Never commit real values.

# Signs wallet session cookies (HMAC-SHA256). At least 32 random characters:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# Changing it signs everyone out.
PIKAMD_SESSION_SECRET=

# Arc network: "testnet" (default) or "mainnet" (ARC.md §2).
NEXT_PUBLIC_ARC_NETWORK=testnet

# Optional RPC for the browser (keyed provider URL, domain-restricted). Default: public Arc RPC.
NEXT_PUBLIC_ARC_RPC_URL=

# Optional RPC for the server (signature checks of smart-contract wallets). Server only.
ARC_RPC_URL=

# Extra hosts allowed to reach /mcp besides localhost (comma-separated).
PIKAMD_ALLOWED_HOSTS=
